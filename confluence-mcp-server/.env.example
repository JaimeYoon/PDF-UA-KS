# Confluence 설정 (Confluence Cloud)
CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net/wiki
CONFLUENCE_EMAIL=your@email.com
CONFLUENCE_API_TOKEN=your_api_token_here

# Confluence 설정 (Confluence Server / Data Center)
# CONFLUENCE_BASE_URL=https://confluence.yourcompany.com
# CONFLUENCE_USERNAME=your_username
# CONFLUENCE_PASSWORD=your_password
# CONFLUENCE_TYPE=server   # cloud | server

# 보고서가 있는 Confluence Space Key (예: WEEKLY, TEAM 등)
CONFLUENCE_SPACE_KEY=WEEKLY

# 주간보고 페이지 제목 패턴 (정규식)
# 예: "주간보고 2025-01-06", "Weekly Report 2025 W02"
REPORT_TITLE_PATTERN=주간보고

# Anthropic API (보고서 분석용)
ANTHROPIC_API_KEY=your_anthropic_api_key

# WordPress 연동 설정
WORDPRESS_URL=http://your-synology-nas-ip/wordpress
WORDPRESS_API_USER=admin
WORDPRESS_API_PASSWORD=your_application_password

# MCP HTTP 서버 포트 (WordPress → MCP 통신용)
MCP_HTTP_PORT=3456

# 자동 동기화 주기 (cron 표현식)
# 기본: 매일 오전 9시와 오후 6시
SYNC_CRON=0 9,18 * * 1-5
